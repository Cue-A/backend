# EC2 의 ~/cue-a/.env 로 복사해 채웁니다. 이 파일만 서버에 있고 저장소에는 올리지 않습니다.
#   cp .env.prod.example .env && vi .env
# 배포 워크플로우는 .env 를 건드리지 않습니다. 값을 바꾸면 서버에서 직접 고치고
#   docker compose -f docker-compose.prod.yml up -d
# 로 재기동하세요.

# ── 도메인 · 인증서 ──────────────────────────────────────
API_DOMAIN=api.example.com
CERTBOT_EMAIL=

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_DB=cuea
POSTGRES_USER=cuea
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# ── 스토리지 (S3) ────────────────────────────────────────
APP_STORAGE_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
APP_STORAGE_BUCKET=cue-a-media
APP_STORAGE_REGION=ap-northeast-2
APP_STORAGE_PATH_STYLE_ACCESS=false
# IAM 사용자 cue-a-backend 의 키
APP_STORAGE_ACCESS_KEY=
APP_STORAGE_SECRET_KEY=

# ── JWT ──────────────────────────────────────────────────
# 기본값이면 기동에 실패합니다.  openssl rand -base64 48
APP_JWT_SECRET=

# ── 카카오 로그인 ─────────────────────────────────────────
# 기본값이면 기동에 실패합니다.
APP_OAUTH_KAKAO_CLIENT_ID=
APP_OAUTH_KAKAO_CLIENT_SECRET=

# ── AI 서버 ───────────────────────────────────────────────
APP_AI_BASE_URL=https://
APP_AI_SECRET=
APP_AI_MOCK_ENABLED=false

# ── CORS ─────────────────────────────────────────────────
# API 와 WebSocket 이 같이 씁니다. 쉼표로 구분, 끝에 / 를 붙이지 마세요.
APP_CORS_ALLOWED_ORIGINS=https://frontend-hl9w.vercel.app,http://localhost:5173,http://localhost:3000
