# 이 파일을 .env 로 복사해서 씁니다.  cp .env.example .env
# 로컬 개발은 아래 기본값 그대로 동작합니다. .env 는 커밋하지 마세요.

# ── 프로파일 ──────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_DB=cuea
POSTGRES_USER=cuea
POSTGRES_PASSWORD=cuea
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cuea
SPRING_DATASOURCE_USERNAME=cuea
SPRING_DATASOURCE_PASSWORD=cuea

# ── Redis ────────────────────────────────────────────────
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ── 스토리지 (로컬 MinIO / 배포 S3) ─────────────────────────
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_BUCKET=cue-a-media
APP_STORAGE_ACCESS_KEY=minioadmin
APP_STORAGE_SECRET_KEY=minioadmin
APP_STORAGE_REGION=us-east-1
# MinIO 는 true 필수. 실제 S3 로 가면 false
APP_STORAGE_PATH_STYLE_ACCESS=true

# ── JWT ──────────────────────────────────────────────────
# HS256 용 시크릿. 최소 32바이트. 배포 환경에서는 반드시 교체하세요.
APP_JWT_SECRET=local-dev-only-secret-change-me-at-least-32-bytes

# ── AI 서버 ───────────────────────────────────────────────
# local 프로파일: http://localhost:8000 / docker 프로파일: http://python-ai:8000
APP_AI_BASE_URL=http://localhost:8000
# Spring ↔ AI 공유 시크릿 (X-CueA-Secret 헤더)
APP_AI_SECRET=local-dev-only-ai-secret
# AI 서버가 아직 없으면 true 로 두면 내부 목이 응답합니다.
APP_AI_MOCK_ENABLED=true

# ── CORS ─────────────────────────────────────────────────
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI 서버 자체 환경변수는 아직 목록을 받지 못했습니다.
# docs/90-open-questions.md 8번 참고.
